# Variables à définir dans Dokploy (onglet Environment de l'app portfolio).
# NE PAS committer de vraies valeurs. En prod, Dokploy les injecte dans l'environnement.

# ============================================================
#  SMTP (unique ; aucun secours automatique)
#  Gmail, car l'envoi SMTP de la boîte OVH est bloqué depuis la
#  suspension pour spam. Repasse OVH en primaire quand OVH rétablit l'envoi.
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_USERNAME=tbirostweb@gmail.com
# App password Gmail (16 caractères, SANS espaces) : https://myaccount.google.com/apppasswords
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_SECURE=tls

# Destinataire des messages reçus (défaut : contact@theo-birost.fr).
# CONTACT_TO=tbirostweb@gmail.com

# OBLIGATOIRE : secret aléatoire (>= 32 octets) pour signer le jeton anti-spam (HMAC).
# Absent ou trop court : le formulaire est désactivé et send_mail.php répond 503.
# Génère-en un avec :  openssl rand -hex 32   (à saisir dans Dokploy > Environment uniquement)
CONTACT_FORM_SECRET=

# --- Exploitation (optionnel) ---
# Port d'écoute du conteneur (défaut 8080, >= 1024) : le domaine Dokploy doit pointer dessus.
# PORT=
# Proxys de confiance pour X-Forwarded-For (CIDR séparés par des virgules).
# Défaut : réseaux privés (127/8, 10/8, 172.16/12, 192.168/16, ::1, fc00::/7).
# TRUSTED_PROXIES=
# Quota : envois max par IP et par heure (défaut 5) ; plafond global par 24 h (défaut 30, 0 = illimité).
# CONTACT_IP_MAX=
# CONTACT_DAILY_MAX=
# Kill-switch : 1 coupe le formulaire (503) sans redéployer.
# CONTACT_FORM_DISABLED=
# Répertoire d'état (quota, nonces) ; défaut : <tmp>/contact_form. Si indisponible : 503 (fail-closed).
# CONTACT_STATE_DIR=
# SMTP_SECURE=none est réservé aux tests locaux (faux serveur SMTP), jamais en production.

